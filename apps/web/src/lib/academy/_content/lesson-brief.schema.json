{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webhound.academy.lessonBrief.v1",
  "title": "Lesson Design Brief",
  "description": "Phase 2B — upstream design contract for every Academy lesson. Mirrors _content/lesson-brief-schema.ts.",
  "type": "object",
  "required": [
    "schema", "status", "volatility", "reviewBy", "identity", "purpose", "audience",
    "prerequisites", "outcomes", "businessContext", "enterpriseContext",
    "interviewIntel", "vocabIntel", "misconceptions", "diagramNeeds", "labIntel",
    "crossLinks", "difficultyIntel", "writingGuidance"
  ],
  "properties": {
    "schema": { "const": "webhound.academy.lessonBrief.v1" },
    "status": { "enum": ["draft", "approved"] },
    "volatility": { "enum": ["evergreen", "stable", "volatile"] },
    "reviewBy": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "identity": {
      "type": "object",
      "required": ["lessonId", "graphNodeId", "volume", "module", "chapter", "lesson", "version"],
      "properties": {
        "lessonId": { "type": "string" }, "graphNodeId": { "type": "string", "minLength": 1 },
        "volume": { "type": "string" }, "module": { "type": "string" },
        "chapter": { "type": "string" }, "lesson": { "type": "string" }, "version": { "type": "string" }
      }
    },
    "purpose": {
      "type": "object",
      "required": ["whyExists", "whyLearnerNeeds", "futureDependents", "businessProblem"],
      "properties": {
        "whyExists": { "type": "string", "minLength": 1 },
        "whyLearnerNeeds": { "type": "string", "minLength": 1 },
        "futureDependents": { "type": "array", "items": { "type": "string" } },
        "businessProblem": { "type": "string", "minLength": 1 }
      }
    },
    "audience": {
      "type": "object", "required": ["primaryRoles", "level"],
      "properties": {
        "primaryRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "level": { "enum": ["L1", "L2", "L3", "L4", "L5"] }
      }
    },
    "prerequisites": {
      "type": "object", "required": ["required", "recommended", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "recommended": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["verb", "statement", "bloom"],
        "properties": {
          "verb": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "bloom": { "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"] }
        }
      }
    },
    "businessContext": {
      "type": "object", "required": ["departments", "note"],
      "properties": {
        "departments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "enterpriseContext": {
      "type": "object", "required": ["whereItLives", "owner", "maintainer", "auditor"],
      "properties": {
        "whereItLives": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 },
        "maintainer": { "type": "string", "minLength": 1 }, "auditor": { "type": "string", "minLength": 1 }
      }
    },
    "interviewIntel": {
      "type": "object", "required": ["probability", "likelyQuestions", "traps", "strongAnswerTraits", "weakAnswerTraits", "followUps"],
      "properties": {
        "probability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "likelyQuestions": { "type": "array", "items": { "type": "string" } },
        "traps": { "type": "array", "items": { "type": "string" } },
        "strongAnswerTraits": { "type": "array", "items": { "type": "string" } },
        "weakAnswerTraits": { "type": "array", "items": { "type": "string" } },
        "followUps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "vocabIntel": {
      "type": "object", "required": ["core", "supporting", "business", "audit", "risk", "acronyms", "commonConfusion"],
      "properties": {
        "core": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "supporting": { "type": "array", "items": { "type": "string" } },
        "business": { "type": "array", "items": { "type": "string" } },
        "audit": { "type": "array", "items": { "type": "string" } },
        "risk": { "type": "array", "items": { "type": "string" } },
        "acronyms": { "type": "array", "items": { "type": "string" } },
        "commonConfusion": { "type": "array", "items": { "type": "string" } }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": { "type": "object", "required": ["misconception", "correction"],
        "properties": { "misconception": { "type": "string" }, "correction": { "type": "string" } } }
    },
    "diagramNeeds": {
      "type": "array",
      "items": { "type": "object", "required": ["kind", "why"],
        "properties": {
          "kind": { "enum": ["architecture", "process-flow", "network", "identity-flow", "timeline", "risk-matrix", "control-matrix", "decision-tree", "audit-workflow", "enterprise-data-flow", "swimlane"] },
          "why": { "type": "string" } } }
    },
    "labIntel": {
      "type": "object", "required": ["type", "why"],
      "properties": { "type": { "enum": ["none", "thought-exercise", "guided", "enterprise", "scenario", "case-study", "capstone"] }, "why": { "type": "string" } }
    },
    "crossLinks": {
      "type": "object", "required": ["previous", "future", "related", "domains", "vocab", "interviewTopics"],
      "properties": {
        "previous": { "type": "array", "items": { "type": "string" } },
        "future": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "domains": { "type": "array", "items": { "type": "string" } },
        "vocab": { "type": "array", "items": { "type": "string" } },
        "interviewTopics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "difficultyIntel": {
      "type": "object", "required": ["bloom", "difficulty", "studyMinutes", "readingMinutes", "labMinutes", "reviewMinutes"],
      "properties": {
        "bloom": { "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"] },
        "difficulty": { "enum": ["L1", "L2", "L3", "L4", "L5"] },
        "studyMinutes": { "type": "integer", "minimum": 1 },
        "readingMinutes": { "type": "integer", "minimum": 0 },
        "labMinutes": { "type": "integer", "minimum": 0 },
        "reviewMinutes": { "type": "integer", "minimum": 0 }
      }
    },
    "writingGuidance": {
      "type": "object", "required": ["profile", "instructions"],
      "properties": {
        "profile": { "enum": ["concept-foundation", "concept-standard", "concept-deep", "procedure", "control-audit", "leadership"] },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "enrichment": {
      "description": "Phase 2C OPTIONAL golden-brief authoring layer. Backward-compatible: absent on legacy briefs.",
      "type": "object",
      "required": ["mentalModel", "educationalBoundaries", "teachingStrategy", "industryContext", "auditContext", "vocabAdvanced", "interviewAnswers", "diagramDetail"],
      "properties": {
        "mentalModel": { "type": "string", "minLength": 1 },
        "educationalBoundaries": {
          "type": "object", "required": ["inScope", "outOfScope", "deferredToFuture"],
          "properties": {
            "inScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "outOfScope": { "type": "array", "items": { "type": "string" } },
            "deferredToFuture": { "type": "array", "items": { "type": "string" } }
          }
        },
        "teachingStrategy": {
          "type": "object", "required": ["order", "whyThisSequence", "analogyPoints", "mandatoryDiagramsAt"],
          "properties": {
            "order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "whyThisSequence": { "type": "string", "minLength": 1 },
            "analogyPoints": { "type": "array", "items": { "type": "string" } },
            "mandatoryDiagramsAt": { "type": "array", "items": { "type": "string" } }
          }
        },
        "industryContext": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["industry", "scenario"],
            "properties": {
              "industry": { "enum": ["Manufacturing", "Finance", "Healthcare", "Government", "Technology"] },
              "scenario": { "type": "string", "minLength": 1 }
            }
          }
        },
        "auditContext": {
          "type": "object", "required": ["internalAudit", "externalAudit", "compliance", "executive"],
          "properties": {
            "internalAudit": { "type": "string", "minLength": 1 },
            "externalAudit": { "type": "string", "minLength": 1 },
            "compliance": { "type": "string", "minLength": 1 },
            "executive": { "type": "string", "minLength": 1 }
          }
        },
        "vocabAdvanced": { "type": "array", "items": { "type": "string" } },
        "interviewAnswers": {
          "type": "object", "required": ["averageAnswer", "exceptionalAnswer"],
          "properties": {
            "averageAnswer": { "type": "string", "minLength": 1 },
            "exceptionalAnswer": { "type": "string", "minLength": 1 }
          }
        },
        "diagramDetail": {
          "type": "array",
          "items": {
            "type": "object", "required": ["kind", "complexity", "learningObjective"],
            "properties": {
              "kind": { "enum": ["architecture", "process-flow", "network", "identity-flow", "timeline", "risk-matrix", "control-matrix", "decision-tree", "audit-workflow", "enterprise-data-flow", "swimlane"] },
              "complexity": { "enum": ["low", "medium", "high"] },
              "learningObjective": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
