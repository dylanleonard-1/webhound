# Pinned to bookworm so the Chromium runtime-library package names below
# are deterministic (trixie renames some, e.g. libasound2 -> libasound2t64).
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for production security
RUN useradd --system --create-home --shell /bin/bash webhound

# Install scanner deps first (larger layer, changes less)
COPY scanner/requirements.txt /tmp/scanner-requirements.txt
RUN pip install --no-cache-dir -r /tmp/scanner-requirements.txt

# Install API deps because worker imports from apps.api.*
COPY apps/api/requirements.txt /tmp/api-requirements.txt
RUN pip install --no-cache-dir -r /tmp/api-requirements.txt

# Install worker deps
COPY worker/requirements.txt /tmp/worker-requirements.txt
RUN pip install --no-cache-dir -r /tmp/worker-requirements.txt

# Playwright + Chromium for the browser discovery pass (RC1 fix). Without
# this the deep-scan browser pass defers to a no-op and JS/SPA sites scan
# like static HTML.
#
# NOTE: we deliberately do NOT use `playwright install --with-deps` — on a
# Debian base Playwright falls back to its Ubuntu dependency list, which
# names Ubuntu-only font packages (ttf-unifont, ttf-ubuntu-font-family)
# that have no Debian apt candidate, so --with-deps fails the build. We
# instead apt-install Chromium's runtime libraries by their real Debian
# (bookworm) names, then `playwright install chromium` only DOWNLOADS the
# browser binary (no apt). Installed to a SHARED path so the non-root
# `webhound` runtime user can read it via PLAYWRIGHT_BROWSERS_PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libatspi2.0-0 libcups2 libdrm2 libgbm1 libxcb1 libxkbcommon0 \
    libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
    libpango-1.0-0 libcairo2 libasound2 libglib2.0-0 libxshmfence1 \
    fonts-liberation libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir playwright==1.48.0 \
    && playwright install chromium \
    && chmod -R a+rX /ms-playwright

# Install scanner as an editable package
COPY scanner /app/scanner
RUN pip install --no-cache-dir -e /app/scanner

# Copy application source
COPY apps /app/apps
COPY worker /app/worker

RUN chown -R webhound:webhound /app

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Enable the browser discovery pass now that Chromium is installed. This
# is the operator opt-in the scanner gates on (orchestrator runs the
# browser pass only when the profile asks for it AND this is "1"). Set to
# "0" in the Railway env to disable without rebuilding (e.g. to cut
# per-scan cost) — Railway env vars override this image default.
ENV WEBHOUND_BROWSER_ENABLED=1

USER webhound

# WORKER_CONCURRENCY defaults to 2; override via environment variable.
# Set CELERY_BEAT=1 on EXACTLY ONE worker instance to enable the periodic
# scheduler (otherwise scheduled scans won't fire). With multiple worker
# instances, beat must run on only one of them to avoid duplicate
# dispatches.
CMD ["sh", "-c", "exec celery -A worker.celery_app:celery worker --loglevel=info --concurrency=${WORKER_CONCURRENCY:-2} ${CELERY_BEAT:+--beat --scheduler celery.beat:PersistentScheduler --schedule=/tmp/celerybeat-schedule}"]
